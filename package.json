{
  "name": "hey-ship-action",
  "version": "0.1.2",
  "private": true,
  "description": "GitHub Action that writes inspectable ship evidence linking a commit or release to a Robinhood Chain deployment, ready for GitHub artifact attestations.",
  "license": "MIT",
  "author": "HEY Research Lab",
  "type": "module",
  "homepage": "https://heyresearch.xyz/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey-research-lab/hey-ship-action.git"
  },
  "bugs": {
    "url": "https://github.com/hey-research-lab/hey-ship-action/issues"
  },
  "keywords": [
    "hey-research",
    "robinhood-chain",
    "github-actions",
    "provenance",
    "supply-chain",
    "attestations",
    "ship-evidence"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "action.yml",
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "scan": "node scripts/scan.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
